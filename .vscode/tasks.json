    {
      "label": "Docker: Ubuntu Install",
      "detail": "Run an ubuntu:latest container on the host network with Node.js and bun",
      "type": "process",
      "command": "docker",
      "args": [
        "run",
        "-it",
        "--pull",
        "always",
        "--hostname",
        "ubuntu",
        "--name",
        "ubuntu",
        "--network",
        "host",
        "--entrypoint",
        "bash",
        "ubuntu:latest",
        "-c",
        "if [ ! -e /var/lib/matterbridge-install.done ]; then apt-get update && apt-get install -y --no-install-recommends curl ca-certificates && curl -4 -fsSL https://matterbridge.io/scripts/install-debian.sh -o /tmp/install.sh && bash /tmp/install.sh || exit 1; fi; exec \"$@\"",
        "_",
        "bash"
      ],
      "problemMatcher": []
    },
